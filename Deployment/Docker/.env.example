# ============================================================
# Shree Jewellers — Docker Compose Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# ── Application ───────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
IMAGE_TAG=latest
WEB_ORIGIN=https://shreejewellers.com

# ── Database ─────────────────────────────────────────────────
# Min 8 chars with uppercase, lowercase, number, special char
SQL_SA_PASSWORD=YourStrong@Password123!

# ── JWT Authentication ────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_min_32_chars_random_string_here_xxxxxxxxxx

# ── AES Encryption (Aadhaar/PAN) ─────────────────────────────
# Generate: openssl rand -base64 32
AES_ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_aes_key=

# ── Gold Price API ────────────────────────────────────────────
# Register at: https://www.goldapi.io (free tier available)
GOLD_API_KEY=goldapi-XXXXXXXXXXXXXXXX-io

# ── Email SMTP ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=no-reply@shreejewellers.com
# Use Gmail App Password (not account password)
SMTP_SENDER_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Twilio SMS ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+919999999999
